{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ExpertMD Learning Center",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://expertmd.io"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "colors": {
    "primary": "#A78BFA",
    "light": "#C4B5FD",
    "dark": "#7C3AED",
    "background": {
      "light": "#FFFFFF",
      "dark": "#1A1A1A"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "rounded": "lg",
  "navbar": {
    "links": [
      {
        "label": "What's New",
        "href": "/changelog"
      },
      {
        "label": "Blog",
        "href": "https://expertmd.io/blog"
      },
      {
        "label": "Login",
        "href": "https://expertmd.io/sign-in"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://expertmd.io",
      "linkedin": "https://www.linkedin.com/company/expertmd"
    }
  },
  "navigation": {
